{
  "name": "sieb",
  "version": "0.6.1",
  "private": true,
  "description": "Triage inbox for Trivy Operator findings that silences Prometheus alerts per CVE and image",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernhardkelm/sieb.git"
  },
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*",
    "#server/*": "./src/server/*",
    "#checker/*": "./src/checker/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:mock": "SIEB_SOURCE=mock run-p dev:server:mock dev:client",
    "dev:server": "node --env-file-if-exists=.env.local --watch src/server/main.ts",
    "dev:server:mock": "SIEB_SOURCE=mock node --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node src/server/main.ts",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint . --cache",
    "format": "oxfmt src/ scripts/",
    "fixtures:generate": "node scripts/generateFixtures.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/server": "~2.4.0",
    "@tanstack/vue-virtual": "^3.13.54",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "openid-client": "^6.9.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.10",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.95.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.80.0",
    "oxlint": "~1.95.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
