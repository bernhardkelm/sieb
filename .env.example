# Copy to .env.local, npm run dev and dev:server read it (the mock scripts do not), all values are optional

# Data source: kubectl (local, read-only kubectl against the cluster), mock (fixtures) or incluster
# SIEB_SOURCE=kubectl

# SQLite file relative to the working directory; mock mode defaults to data/sieb-mock.db
# SIEB_DB_PATH=data/sieb.db

# API server listen address and port, the Vite dev server proxies /api, /auth, /metrics, /mcp and /.well-known to SIEB_PORT
# SIEB_HOST=127.0.0.1
# SIEB_PORT=3100

# PromQL for the findings, usually a recording rule, see docs/prometheus-rules.md
# SIEB_FINDINGS_QUERY=sieb:trivy_finding:info

# KEV listing: cisa (fetch the CISA KEV feed daily), prometheus (SIEB_KEV_QUERY, flag only) or none
# SIEB_KEV_SOURCE=cisa

# cisa: URL of the CISA KEV JSON feed or a mirror of it
# SIEB_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# prometheus: PromQL for the KEV list, one series per vuln_id
# SIEB_KEV_QUERY=sieb:kev:listed

# kubectl source: context passed as kubectl --context, unset uses the current context
# SIEB_KUBE_CONTEXT=my-cluster

# kubectl source: Prometheus service as namespace/name:port, reached through the API server proxy
# SIEB_PROMETHEUS_SERVICE=monitoring/kube-prometheus-stack-prometheus:9090

# incluster source: Prometheus base URL
# SIEB_PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090

# Minutes between automatic syncs
# SIEB_SYNC_INTERVAL_MINUTES=15

# header mode: header carrying the username set by the forward-auth proxy
# SIEB_USER_HEADER=X-authentik-username

# header mode: acting user when that header is missing, ignored with NODE_ENV=production
# SIEB_DEV_USER=dev

# Host header values accepted besides localhost, 127.0.0.1 and [::1], comma separated
# SIEB_ALLOWED_HOSTS=sieb.example.com

# MCP endpoint /mcp, personal tokens and OAuth metadata for Claude, off by default, see docs/working-with-claude.md
# SIEB_MCP_ENABLED=true

# Origin sieb is reached at, no path or trailing slash, https in production; required for OAuth and
# SIEB_AUTH=oidc, unset derives it per request
# SIEB_PUBLIC_URL=https://sieb.example.com

# Browser origins /mcp accepts besides its own host, comma separated
# SIEB_MCP_ALLOWED_ORIGINS=http://localhost:6274

# OAuth for claude.ai: issuer (exact iss) and client id (exact aud) together, needs SIEB_PUBLIC_URL
# SIEB_OAUTH_ISSUER=https://authentik.example.com/application/o/sieb-mcp/
# SIEB_OAUTH_CLIENT_ID=sieb-mcp

# OAuth key set URL, unset discovers jwks_uri from the issuer
# SIEB_OAUTH_JWKS_URL=https://authentik.example.com/application/o/sieb-mcp/jwks/

# groups claim entry an OAuth caller must have, unset admits every user of the issuer
# SIEB_OAUTH_REQUIRED_GROUP=sieb-users

# Client name of OAuth callers in logs and tool results
# SIEB_OAUTH_CLIENT_LABEL=Claude

# Separate port serving only /metrics, the main port then answers 404; required with SIEB_AUTH=oidc
# SIEB_METRICS_PORT=9100

# UI auth: header (forward-auth username header) or oidc (sieb's own login, ignores the header)
# SIEB_AUTH=header

# oidc: confidential client of the identity provider, separate from the OAuth client of /mcp;
# SIEB_PUBLIC_URL is required too and the redirect URI is SIEB_PUBLIC_URL/auth/callback
# (http://localhost:5173/auth/callback in development)
# SIEB_OIDC_ISSUER=http://localhost:9000/application/o/sieb/
# SIEB_OIDC_CLIENT_ID=sieb
# SIEB_OIDC_CLIENT_SECRET=
# SIEB_OIDC_REQUIRED_GROUP=sieb-users

# oidc: absolute session lifetime in hours, 1 to 168
# SIEB_SESSION_HOURS=12

# Registry hosts whose third-party images count as public for Auto-check, comma separated, unset keeps the default list
# SIEB_PUBLIC_REGISTRIES=docker.io,index.docker.io,registry-1.docker.io,mirror.gcr.io,ghcr.io,quay.io,registry.k8s.io,gcr.io,public.ecr.aws,mcr.microsoft.com,cgr.dev

# oidc: provider name on the sign-in button ("Sign in with SSO")
# SIEB_OIDC_DISPLAY_NAME=SSO

# Source code link in the UI (AGPL), for forks; unset links github.com/bernhardkelm/sieb/tree/<version>
# SIEB_SOURCE_URL=https://git.example.com/acme/sieb

# Auto-check: queue findings for a separate worker running headless Claude Code, see docs/auto-check.md;
# needs SIEB_MCP_ENABLED=true and SIEB_PUBLIC_URL
# SIEB_CHECKS_ENABLED=false

# Auto-check: port of the listener serving only the worker routes, apart from SIEB_PORT and SIEB_METRICS_PORT
# SIEB_WORKER_PORT=3101

# Auto-check: bearer secret of the worker, at least 32 characters, e.g. openssl rand -base64 32
# SIEB_WORKER_SECRET=

# Auto-check: time limit of one check in seconds, and the turn limit handed to Claude Code
# SIEB_CHECK_TIMEOUT_SECONDS=1200
# SIEB_CHECK_MAX_TURNS=60

# Auto-check private access: 32 random bytes in base64 that seal the stored read credentials, e.g. openssl rand -base64 32;
# SIEB_CREDENTIALS_KEY_FILE reads the key from a file, unset turns private access off
# SIEB_CREDENTIALS_KEY=

# Auto-check private access: bearer secret of the fetcher, at least 32 characters and different from SIEB_WORKER_SECRET;
# SIEB_FETCHER_SECRET_FILE reads it from a file, unset keeps private images ineligible
# SIEB_FETCHER_SECRET=
