# Copy to .env.local, npm run dev:server reads it, all values are optional

# Data source: kubectl (local, read-only kubectl against the cluster), mock (fixtures) or incluster
# SIEB_SOURCE=kubectl

# SQLite file relative to the working directory; mock mode defaults to data/sieb-mock.db
# SIEB_DB_PATH=data/sieb.db

# API server listen address and port, the Vite dev server proxies /api and /metrics to SIEB_PORT
# SIEB_HOST=127.0.0.1
# SIEB_PORT=3100

# PromQL for the findings, usually a recording rule, see docs/prometheus-rules.md
# SIEB_FINDINGS_QUERY=sieb:trivy_finding:info

# KEV listing: cisa (fetch the CISA KEV feed daily), prometheus (SIEB_KEV_QUERY, flag only) or none
# SIEB_KEV_SOURCE=cisa

# cisa: URL of the CISA KEV JSON feed or a mirror of it
# SIEB_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# prometheus: PromQL for the KEV list, one series per vuln_id
# SIEB_KEV_QUERY=sieb:kev:listed

# kubectl source: context passed as kubectl --context, unset uses the current context
# SIEB_KUBE_CONTEXT=my-cluster

# kubectl source: Prometheus service as namespace/name:port, reached through the API server proxy
# SIEB_PROMETHEUS_SERVICE=monitoring/kube-prometheus-stack-prometheus:9090

# incluster source: Prometheus base URL
# SIEB_PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090

# Minutes between automatic syncs
# SIEB_SYNC_INTERVAL_MINUTES=15

# Header carrying the username set by the forward-auth proxy
# SIEB_USER_HEADER=X-authentik-username

# Acting user when that header is missing, ignored with NODE_ENV=production
# SIEB_DEV_USER=dev

# Host header values accepted besides localhost, 127.0.0.1 and [::1], comma separated
# SIEB_ALLOWED_HOSTS=sieb.example.com
